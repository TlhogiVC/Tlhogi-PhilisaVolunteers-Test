<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_md">

    <TextView
        android:id="@+id/tvScheduleTime"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_profile_circle"
        android:gravity="center"
        android:padding="@dimen/spacing_xs"
        android:textColor="@color/purple_700"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold"
        tools:text="08:00" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvScheduleTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Philisa.Subtitle"
            tools:text="Community Feeding Distribution" />

        <TextView
            android:id="@+id/tvScheduleSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Philisa.Caption"
            tools:text="Thu, 1 Aug · Khayelitsha Hall" />
    </LinearLayout>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_back"
        android:rotation="180"
        app:tint="@color/text_secondary" />

</LinearLayout>
