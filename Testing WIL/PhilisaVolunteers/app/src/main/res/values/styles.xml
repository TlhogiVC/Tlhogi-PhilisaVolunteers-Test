<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.Philisa.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/purple_700</item>
        <item name="cornerRadius">@dimen/corner_radius_pill</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="Widget.Philisa.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/divider</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">@dimen/corner_radius_pill</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
    </style>

    <style name="Widget.Philisa.Button.Destructive" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/status_error_text</item>
        <item name="android:textColor">@color/status_error_text</item>
        <item name="cornerRadius">@dimen/corner_radius_pill</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Philisa.Button.Confirm" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/status_success_text</item>
        <item name="cornerRadius">@dimen/corner_radius_pill</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Philisa.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/corner_radius_sm</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_radius_sm</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_radius_sm</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_radius_sm</item>
        <item name="boxStrokeColor">@color/purple_500</item>
        <item name="hintTextColor">@color/text_secondary</item>
    </style>

    <style name="Widget.Philisa.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/white</item>
        <item name="itemIconTint">@color/purple_700</item>
        <item name="itemTextColor">@color/purple_700</item>
        <item name="elevation">8dp</item>
    </style>

    <style name="TextAppearance.Philisa.Display" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_on_purple</item>
        <item name="fontFamily">serif</item>
    </style>

    <style name="TextAppearance.Philisa.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Philisa.Subtitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Philisa.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Philisa.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.Philisa.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/corner_radius_md</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="contentPadding">@dimen/spacing_md</item>
    </style>

    <style name="Widget.Philisa.StatusPill" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:background">@drawable/bg_pill_status</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
