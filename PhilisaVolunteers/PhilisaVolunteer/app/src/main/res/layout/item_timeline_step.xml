<?xml version="1.0" encoding="utf-8"?>
<!--
  Single row of the vertical status timeline on fragment_application_status.xml
  (Figure 54). For a completed step: ivStatusIcon shows ic_check_circle
  tinted purple/green and ivConnector is VISIBLE; for a pending step: swap
  ivStatusIcon for a plain grey dot background and dim tvTitle/tvDate.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivStatusIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_icon_circle"
            android:backgroundTint="@color/purple_600"
            android:contentDescription="@null"
            android:padding="4dp"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/surface_white" />

        <View
            android:id="@+id/ivConnector"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginVertical="2dp"
            android:background="@color/border_light" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/timeline_submitted"
            android:textAppearance="@style/TextAppearance.Philisa.Title"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption"
            tools:text="29 Jul 2024" />

    </LinearLayout>

</LinearLayout>
