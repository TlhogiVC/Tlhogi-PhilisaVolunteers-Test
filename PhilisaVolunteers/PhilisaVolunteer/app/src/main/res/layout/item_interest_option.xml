<?xml version="1.0" encoding="utf-8"?>
<!--
  Single selectable programme-interest row for the RecyclerView in
  fragment_apply_step2_interests.xml (Figure 52). Bind:
  - ivIcon: swap ic_programme_placeholder per programme
  - tvLabel: programme name
  - ivChecked visibility (VISIBLE/GONE) + card strokeColor: selected state
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardInterest"
    style="@style/Widget.Philisa.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:checkable="true"
    app:strokeColor="@color/border_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_md">

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="@dimen/icon_circle_size"
            android:layout_height="@dimen/icon_circle_size"
            android:background="@drawable/bg_icon_circle"
            android:contentDescription="@null"
            android:padding="10dp"
            android:src="@drawable/ic_programme_placeholder" />

        <TextView
            android:id="@+id/tvLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:text="@string/programme_womens_empowerment"
            android:textAppearance="@style/TextAppearance.Philisa.Title" />

        <ImageView
            android:id="@+id/ivChecked"
            android:layout_width="@dimen/icon_size_md"
            android:layout_height="@dimen/icon_size_md"
            android:contentDescription="@null"
            android:src="@drawable/ic_check_circle"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
