<?xml version="1.0" encoding="utf-8"?>
<!-- Figure 50: Landing screen - Become a Volunteer / Volunteer Login + About Us -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gradient_header_rounded"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_xl"
        android:paddingBottom="@dimen/spacing_lg"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivCrest"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_icon_circle"
            android:contentDescription="@string/welcome_org_name"
            android:padding="14dp"
            android:src="@drawable/ic_check_circle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:letterSpacing="0.12"
            android:text="@string/landing_eyebrow"
            android:textColor="#CBB6F5"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivCrest" />

        <TextView
            android:id="@+id/tvOrgName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:gravity="center"
            android:text="@string/welcome_org_name"
            android:textAppearance="@style/TextAppearance.Philisa.Headline"
            android:textColor="@color/text_on_purple"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvEyebrow" />

        <TextView
            android:id="@+id/tvOrgSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:textStyle="italic"
            android:text="@string/welcome_org_subtitle"
            android:textColor="#E9E1F7"
            android:textSize="@dimen/text_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvOrgName" />

        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center"
            android:text="@string/landing_tagline"
            android:textColor="#B9A6DD"
            android:textSize="@dimen/text_caption"
            android:textStyle="italic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvOrgSubtitle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBecomeVolunteer"
            style="@style/Widget.Philisa.Button.Primary"
            android:layout_width="0dp"
            android:layout_marginTop="@dimen/spacing_lg"
            android:backgroundTint="@color/purple_500"
            android:text="@string/landing_btn_become_volunteer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTagline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolunteerLogin"
            style="@style/Widget.Philisa.Button.OutlineOnDark"
            android:layout_width="0dp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/landing_btn_login"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBecomeVolunteer" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_xl"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="@string/landing_about_eyebrow"
                android:textColor="@color/purple_600"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/landing_about_title"
                android:textAppearance="@style/TextAppearance.Philisa.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/landing_about_body"
                android:textAppearance="@style/TextAppearance.Philisa.Body" />

            <!-- Placeholder tint until a real photo asset (e.g. img_about_us.webp) is added -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_icon_circle"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@color/purple_100"
                tools:ignore="ContentDescription"
                tools:src="@tools:sample/backgrounds/scenic" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
